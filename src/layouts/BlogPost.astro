---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TagList from '../components/TagList.astro';
import { SITE_AUTHOR } from '../consts';
import { getHeroImage } from '../utils/heroImages';
import { url } from '../utils/paths';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage: heroImageName, tags } = Astro.props;
const heroImage = getHeroImage(heroImageName);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				line-height: 1.45;
			}
			.back {
				display: inline-block;
				margin-top: 0.75em;
				font-size: 0.85em;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back:hover {
				color: var(--accent);
			}
			.title {
				margin-bottom: 0.75em;
				padding: 0.5em 0;
				text-align: center;
				line-height: 1.15;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.35em;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-tags {
				display: flex;
				justify-content: center;
				margin-bottom: 0.5em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && <PageHero image={heroImage} alt="" priority />}
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} /> · {SITE_AUTHOR}
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<div class="post-tags"><TagList tags={tags} /></div>
						<hr />
					</div>
					<slot />
					<a class="back" href={url('blog')}>← All posts</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
