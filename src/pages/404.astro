---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import { notFoundHero } from '../utils/heroImages';
import { url } from '../utils/paths';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found" description="That page wandered off." image={notFoundHero} />
		<style>
			main {
				text-align: center;
				padding-top: 1em;
			}
			.code {
				font-size: clamp(4rem, 18vw, 8rem);
				font-weight: bold;
				line-height: 1;
				color: var(--accent);
				letter-spacing: -0.05em;
			}
			p {
				color: rgb(var(--gray));
			}
			a.button {
				display: inline-block;
				margin-top: 1em;
				padding: 0.5em 1.1em;
				border-radius: 999px;
				background: var(--accent);
				color: white;
				text-decoration: none;
				font-weight: bold;
				font-size: 0.9em;
			}
			a.button:hover {
				background: var(--accent-dark);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<PageHero image={notFoundHero} alt="A lost robot holding a map" priority />
			<div class="code">404</div>
			<h1>This page wandered off</h1>
			<p>Maybe it's compiling somewhere, or maybe it never existed.</p>
			<a class="button" href={url()}>Back home</a>
		</main>
		<Footer />
	</body>
</html>
