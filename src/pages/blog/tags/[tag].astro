---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import PageHero from '../../../components/PageHero.astro';
import TagList from '../../../components/TagList.astro';
import { getHeroImage, tagsHero } from '../../../utils/heroImages';
import { getAllTags } from '../../../utils/tags';
import { url } from '../../../utils/paths';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	return getAllTags(posts).map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

interface Props {
	tag: string;
	posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Posts tagged “${tag}”`}
			description={`Posts tagged “${tag}”`}
			image={tagsHero}
		/>
		<style>
			h1 {
				margin: 0 0 1em;
				font-size: 1.8em;
				letter-spacing: -0.02em;
			}
			.posts {
				display: grid;
				gap: 1em;
				list-style: none;
				margin: 0 0 2em;
				padding: 0;
			}
			.posts li {
				padding: 1.1em 1.25em;
				border-radius: 12px;
				background: white;
				box-shadow: 0 1px 3px rgba(var(--gray), 20%);
				transition:
					transform 0.15s ease,
					box-shadow 0.15s ease;
			}
			.posts li:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			.posts a {
				display: block;
				color: inherit;
				text-decoration: none;
			}
			.post-top {
				display: flex;
				gap: 1em;
				align-items: center;
			}
			.post-thumb {
				width: 96px;
				height: 64px;
				object-fit: cover;
				border-radius: 8px;
				flex-shrink: 0;
				background: rgb(var(--gray-light));
			}
			.post-meta {
				min-width: 0;
			}
			.posts time {
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.posts h2 {
				margin: 0.15em 0 0;
				font-size: 1.15em;
				color: rgb(var(--black));
			}
			.posts p {
				margin: 0.6em 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.post-tags {
				margin-top: 0.75em;
			}
			.back {
				font-size: 0.85em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<PageHero image={tagsHero} alt="Colorful floating tag labels" priority />
			<h1>Posts tagged “{tag}”</h1>
			<ul class="posts">
				{
					posts.map((post) => {
						const thumb = getHeroImage(post.data.heroImage);
						return (
							<li>
								<a href={url(`blog/${post.id}/`)}>
									<div class="post-top">
										{thumb && (
											<Image
												src={thumb}
												alt=""
												width={192}
												height={128}
												class="post-thumb"
												loading="lazy"
											/>
										)}
										<div class="post-meta">
											<time datetime={post.data.pubDate.toISOString()}>
												<FormattedDate date={post.data.pubDate} />
											</time>
											<h2>{post.data.title}</h2>
										</div>
									</div>
									<p>{post.data.description}</p>
								</a>
								<div class="post-tags"><TagList tags={post.data.tags} /></div>
							</li>
						);
					})
				}
			</ul>
			<a class="back" href={url('blog/tags')}>← All tags</a>
		</main>
		<Footer />
	</body>
</html>
