---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PageHero from '../../../components/PageHero.astro';
import { SITE_DESCRIPTION } from '../../../consts';
import { tagsHero } from '../../../utils/heroImages';
import { getAllTags, tagPaletteClass, tagUrl } from '../../../utils/tags';
import { url } from '../../../utils/paths';

const posts = await getCollection('blog');
const tags = getAllTags(posts).map((tag) => ({
	name: tag,
	count: posts.filter((post) => post.data.tags.includes(tag)).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Tags" description={SITE_DESCRIPTION} image={tagsHero} />
		<style>
			h1 {
				margin-bottom: 0.75em;
				font-size: 1.8em;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				list-style: none;
				margin: 0 0 2em;
				padding: 0;
			}
			.tag {
				display: inline-block;
				padding: 0.3em 0.8em;
				border: 1px solid var(--tag-border);
				border-radius: 999px;
				background: var(--tag-bg);
				color: var(--tag-text);
				font-family: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas,
					monospace;
				font-size: 0.8em;
				font-weight: 500;
				text-decoration: none;
				transition:
					border-color 0.15s ease,
					box-shadow 0.15s ease;
			}
			.tag:hover {
				border-color: var(--tag-text);
				box-shadow: 0 1px 4px rgba(var(--gray), 25%);
			}
			.count {
				opacity: 0.7;
				font-size: 0.85em;
			}
			.back {
				font-size: 0.85em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<PageHero image={tagsHero} alt="Colorful floating tag labels" priority />
			<h1>Tags</h1>
			{
				tags.length > 0 ? (
					<ul>
						{tags.map((tag) => (
							<li>
								<a class={`tag ${tagPaletteClass(tag.name)}`} href={tagUrl(tag.name)}>
									#{tag.name} <span class="count">{tag.count}</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p>No posts have been tagged yet.</p>
				)
			}
			<a class="back" href={url('blog')}>← All posts</a>
		</main>
		<Footer />
	</body>
</html>
