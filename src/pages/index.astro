---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2em 0 1em;
			}
			.hero h1 {
				font-size: clamp(1.9rem, 5vw, 2.6rem);
				line-height: 1.05;
				margin: 0 0 0.4em;
				letter-spacing: -0.03em;
			}
			.hero .lede {
				font-size: 0.95em;
				max-width: 34em;
				color: rgb(var(--gray));
			}
			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				margin: 2em 0 1em;
			}
			.actions a {
				display: inline-block;
				padding: 0.5em 1.1em;
				border-radius: 999px;
				border: 2px solid var(--accent);
				color: var(--accent);
				font-weight: bold;
				text-decoration: none;
				font-size: 0.9em;
			}
			.actions a.primary {
				background: var(--accent);
				color: white;
			}
			.actions a:hover {
				background: var(--accent-dark);
				border-color: var(--accent-dark);
				color: white;
			}
			.section-title {
				margin: 2.5em 0 1em;
				font-size: 0.8em;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: rgb(var(--gray));
			}
			.posts {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1em;
			}
			.posts a {
				display: block;
				padding: 1.1em 1.25em;
				border-radius: 12px;
				background: white;
				box-shadow: 0 1px 3px rgba(var(--gray), 20%);
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.15s ease,
					box-shadow 0.15s ease;
			}
			.posts a:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			.posts h2 {
				margin: 0 0 0.25em;
				font-size: 1.15em;
				color: rgb(var(--black));
			}
			.posts p {
				margin: 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.posts time {
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.more {
				display: inline-block;
				margin-top: 1.25em;
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>The World of Nerdy Tim</h1>
				<p class="lede">
					{SITE_DESCRIPTION}
				</p>
				<div class="actions">
					<a class="primary" href={url('blog')}>Read the blog</a>
					<a href={url('about')}>About me</a>
				</div>
			</section>

			<h2 class="section-title">Latest posts</h2>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={url(`blog/${post.id}/`)}>
								<time datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
			<a class="more" href={url('blog')}>See all posts →</a>
		</main>
		<Footer />
	</body>
</html>
