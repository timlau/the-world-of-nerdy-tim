---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	priority?: boolean;
}

const { image, alt, priority = false } = Astro.props;
const width = Math.min(image.width, 1020);
const height = Math.round(width * (image.height / image.width));
---

<div class="page-hero">
	<Image
		src={image}
		alt={alt}
		width={width}
		height={height}
		loading={priority ? 'eager' : 'lazy'}
		class="page-hero__image"
	/>
</div>

<style>
	.page-hero {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto 1.5em;
	}
	.page-hero__image {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: 0 1px 3px rgba(var(--gray), 20%);
	}
</style>
