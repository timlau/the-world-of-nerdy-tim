---
import { SITE_AUTHOR, SITE_GITHUB, SITE_TITLE, SITE_X, SITE_YOUTUBE } from '../consts';
import { url } from '../utils/paths';
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} {SITE_AUTHOR} · {SITE_TITLE}
	</p>
	<div class="social-links">
		<a href={SITE_GITHUB} target="_blank" rel="me">
			<span class="sr-only">Tim on GitHub</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
		<a href={SITE_YOUTUBE} target="_blank" rel="me">
			<span class="sr-only">Tim on YouTube</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path
					fill="currentColor"
					d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
				></path>
			</svg>
		</a>
		<a href={SITE_X} target="_blank" rel="me">
			<span class="sr-only">Tim on X</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path
					fill="currentColor"
					d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932zm-.65 19.29h2.039L6.486 3.24H4.298z"
				></path>
			</svg>
		</a>
		<a href={url('rss.xml')}>
			<span class="sr-only">RSS feed</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28">
				<path
					fill="currentColor"
					d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0ZM1.82 8.91v3.05a10.22 10.22 0 0 1 10.22 10.22h3.05c0-7.33-5.95-13.27-13.27-13.27ZM1.82 2.18v3.05c9.94 0 18 8.06 18 18h3.05c0-11.63-9.42-21.05-21.05-21.05Z"
				></path>
			</svg>
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer p {
		margin: 0;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.5em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
