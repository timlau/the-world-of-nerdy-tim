---
import { tagPaletteClass, tagUrl } from '../utils/tags';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a class={`tag ${tagPaletteClass(tag)}`} href={tagUrl(tag)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tags a {
		display: inline-block;
		padding: 0.15em 0.65em;
		border: 1px solid var(--tag-border);
		border-radius: 999px;
		background: var(--tag-bg);
		color: var(--tag-text);
		font-family: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		font-size: 0.7em;
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: -0.02em;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}
	.tags a:hover {
		border-color: var(--tag-text);
		box-shadow: 0 1px 4px rgba(var(--gray), 25%);
	}
</style>
