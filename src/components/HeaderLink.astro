---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	matchNested?: boolean;
}

const { href, class: className, matchNested = false, ...props } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const stripBase = (path: string) => (base && path.startsWith(base) ? path.slice(base.length) : path);
const current = normalize(stripBase(Astro.url.pathname) || '/');
const target = normalize(stripBase(String(href)));
const isActive =
	matchNested && target !== '/'
		? current === target || current.startsWith(`${target}/`)
		: target === current;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
